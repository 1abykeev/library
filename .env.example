# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_DB=library
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# ── Backend (FastAPI) ─────────────────────────────────────────
# Use service name "postgres" as hostname when running via Docker
DATABASE_URL=postgresql+psycopg2://postgres:<password>@postgres:5432/library
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
UPLOAD_DIR=./uploads

# ── Frontend (Next.js) ────────────────────────────────────────
# Must point to the backend as seen from the browser (host machine)
NEXT_PUBLIC_API_URL=http://localhost:8000
